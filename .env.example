# Copy to .env and load with your process manager, or export these directly.
PORT=3000
# Localhost by default on purpose. Tunnel in with `ssh -L` rather than changing this.
BIND=127.0.0.1
# Confine every file operation below this path. Leave unset for full access.
# ROOT_JAIL=/home/youruser
# Port forwards may bind non-loopback addresses on the relay host. Off by
# default: a forward on 0.0.0.0 hands the tunnel to anyone who can reach you.
# ALLOW_PUBLIC_FORWARDS=1
# Extra Host header values to accept, comma separated. Defaults cover
# localhost, 127.0.0.1 and [::1] on PORT. Needed behind a reverse proxy.
# ALLOWED_HOSTS=ssh.example.com
# Close sessions with no open window after this many idle minutes. 0 never does.
# SESSION_IDLE_MINUTES=15
# Most SSH sessions this relay will hold at once, across every browser tab.
# Each one costs a TCP connection, an SFTP channel and any PTYs it opened;
# a further connect is refused with 429. The browser caps itself at 8 per tab.
# MAX_SESSIONS=16
# Serve HTTPS instead of HTTP. Both are required together.
# TLS_CERT=/etc/ssl/certs/su-ssh.pem
# TLS_KEY=/etc/ssl/private/su-ssh.key
# Where verified host keys are pinned (created 0600).
# KNOWN_HOSTS_FILE=/home/youruser/.config/su-ssh/known_hosts.json
# Existing known_hosts consulted for servers you already trust.
# SSH_KNOWN_HOSTS=/home/youruser/.ssh/known_hosts
# Set to 1 to drop the per-launch access link. Only behind a proxy that
# authenticates users itself.
# NO_ACCESS_KEY=1
